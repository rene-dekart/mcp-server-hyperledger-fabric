# ── gRPC endpoint of the gateway peer (direct access) ──
# test-network default: localhost:7051
FABRIC_PEER_ENDPOINT=localhost:7051
# Default channel advertised to the client in the server instructions
# FABRIC_CHANNEL=mychannel

# TLS: true — with tls-ca-cert.pem; false — dev only (test-network)
FABRIC_TLS=true
FABRIC_PEER_TLS_CERT=./certs/tls-ca-cert.pem

# Only when connecting through an SSH tunnel (endpoint=localhost:PORT):
# FABRIC_PEER_TLS_SERVER_NAME=peer0.org1.example.com

# ── Identity (enrollment certificates) ──
FABRIC_MSP_ID=Org1MSP
FABRIC_CERT=./certs/admin.pem
FABRIC_KEY=./certs/admin.key

# Optional: Fabric Gateway REST API for get_blockchain_info
# FABRIC_REST_URL=http://localhost:7152

# Optional: chaincode API descriptions (from `mcp-server-hyperledger-fabric scan`).
# File or directory of chaincode-api.json files. Default: ./chaincode-api
# FABRIC_CHAINCODE_API=./chaincode-api

# Read-only mode: expose only read tools (no invoke_chaincode, no endorse_chaincode).
# FABRIC_READ_ONLY=true

# Log transientData values in full. Default: keys, sizes and a short hash only.
# FABRIC_LOG_TRANSIENT=true

# Timeout for each network call, ms
REQUEST_TIMEOUT_MS=30000

# Dedup window for write calls, ms. 0 = off (default).
# When > 0, an identical invoke (same chaincode, method, args) within the
# window is not re-sent — the previous txid is returned instead. Guards
# against double-writes from retried invokes. In-memory only, exact-args match.
# FABRIC_DEDUP_WINDOW_MS=60000
